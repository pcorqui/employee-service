{
  "info": {
    "_postman_id": "1369ee04-db03-433f-b0bf-55f4f05aefb2",
    "name": "Employee Microservice API (JWT)",
    "description": "Colección para probar los endpoints CRUD, búsqueda, autenticación JWT y Health Check del microservicio de Empleados.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "13861360"
  },
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Login (Obtener JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set(\"jwt_token\", jsonData.token);",
                  "    console.log(\"Token JWT guardado automáticamente.\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Empleados",
      "item": [
        {
          "name": "Crear uno o varios empleados",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n    {\n        \"firstName\": \"Carlos\",\n        \"middleName\": \"Alberto\",\n        \"lastName\": \"Pérez\",\n        \"secondLastName\": \"Gómez\",\n        \"age\": 30,\n        \"gender\": \"Masculino\",\n        \"birthDate\": \"15-05-1996\",\n        \"active\": true\n    },\n    {\n        \"firstName\": \"Ana\",\n        \"middleName\": \"Sofía\",\n        \"lastName\": \"Martínez\",\n        \"secondLastName\": \"López\",\n        \"age\": 28,\n        \"gender\": \"Femenino\",\n        \"birthDate\": \"22-08-1998\",\n        \"active\": true\n    }\n]"
            },
            "url": {
              "raw": "{{base_url}}/employees",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "employees"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Listar todos los empleados",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/employees",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "employees"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Obtener empleado por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/employees/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "employees",
                "1"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Buscar empleados por nombre (Parcial)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/employees/search?name=Car",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "employees",
                "search"
              ],
              "query": [
                {
                  "key": "name",
                  "value": "Car"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Actualizar empleado (Parcial o Total)",
          "request": {
            "method": "PUT",
            "header": [
