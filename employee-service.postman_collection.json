                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"age\": 31,\n    \"active\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/employees/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "employees",
                "1"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Eliminar empleado por ID",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/employees/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "employees",
                "1"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Monitoreo (DevSecOps)",
      "item": [
        {
          "name": "Health Check (Actuator)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/actuator/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "jwt_token",
      "value": ""
    }
  ]
